# MinIO Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=pdf-storage

# PostgreSQL Configuration
# IMPORTANT: Never commit actual credentials to version control!
# Use environment-specific values and keep .env file secure and gitignored.

# Option 1: Use connection string (recommended for simplicity)
DATABASE_URL=postgresql://username:password@localhost:5432/p2m_database

# Option 2: Use individual parameters (useful for some deployment scenarios)
# Note: If DATABASE_URL is set, it takes precedence over individual parameters
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=p2m_database
# PGUSER=your_username
# PGPASSWORD=your_password

# Server Configuration
PORT=3000

# Default tenant ID (you can change this to match your setup)
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000
