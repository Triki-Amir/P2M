FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for OCR processing:
#   poppler-utils  – pdf2image uses pdftoppm from poppler
#   tesseract-ocr  – OCR engine
#   tesseract-ocr-ara, tesseract-ocr-fra – Arabic and French language data
#   (English is included by default with tesseract-ocr)
#   libpq-dev      – PostgreSQL client library for psycopg2
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        poppler-utils \
        tesseract-ocr \
        tesseract-ocr-ara \
        tesseract-ocr-fra \
        libpq-dev && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app/ app/
COPY rabbitmq_server/ rabbitmq_server/

CMD ["python", "-m", "rabbitmq_server.start_consumer"]
